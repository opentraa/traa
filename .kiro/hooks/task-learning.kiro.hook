{
  "enabled": true,
  "name": "Update Agents After Task",
  "description": "After a spec task is completed, check if the implementation introduced new patterns, modified module interfaces, or changed the project structure in ways that should be reflected in the AGENTS.md documentation.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "A spec task just completed. Quickly check if any of these happened:\n1. New source files were created — if so, verify the relevant AGENTS.md directory structure is still accurate\n2. New public API functions were added — update the root AGENTS.md API section\n3. New CMake targets or dependencies were added — update the build targets table\n4. A feature moved from \"Not Yet Implemented\" to \"Implemented\" — update status sections\n\nOnly make updates if concrete changes occurred. Be surgical — append or modify specific lines, don't rewrite sections. If nothing significant changed, skip silently."
  }
}